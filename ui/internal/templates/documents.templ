package templates

import (
	"encoding/base64"
	"strings"

	"github.com/GustavoCaso/folio/ui/internal/domain"
	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/collapsible"
	"github.com/templui/templui/components/icon"
)

func coverBase64(j domain.Job) string {
	return base64.StdEncoding.EncodeToString(j.Cover)
}

templ jobCard(j domain.Job) {
	@card.Card(card.Props{ID: "job-" + j.ID}) {
		@card.Content(card.ContentProps{Class: "flex flex-col gap-3"}) {
			<div class="flex items-start justify-between gap-2">
				<p class="font-medium text-sm leading-snug truncate" data-filename>{ j.Filename }</p>
				<span data-status-badge>
					@jobBadge(j.Status)
				</span>
			</div>
			<div data-metadata class="flex flex-col gap-1">
				if len(j.Cover) > 0 {
					<img
						data-cover
						src={ "data:image/png;base64," + coverBase64(j) }
						alt="cover"
						class="w-full rounded object-cover aspect-[3/4] bg-muted"
					/>
				}
				if j.Title != "" {
					<p data-title class="text-xs font-medium truncate">Title: { j.Title }</p>
				}
				if j.Author != "" {
					<p data-author class="text-xs text-muted-foreground truncate">Author: { j.Author }</p>
				}
				if len(j.Tags) > 0 {
					<div class="flex flex-wrap gap-1 mt-1">
						for _, tag := range j.Tags {
							<span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">{ tag }</span>
						}
					</div>
				}
			</div>
			<p class="text-xs text-muted-foreground" data-status-text>
				if j.Status == "FAILED" {
					{ j.Error }
				}
			</p>
			<div class="flex items-center gap-2 mt-1" data-actions>
				if j.Status == "PENDING" {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Attributes: map[string]any{"data-cancel-job": j.ID, "data-job-name": j.Filename},
						Size:       button.SizeSm,
						Class:      "text-destructive hover:text-destructive",
						Type:       button.TypeButton,
					}) {
						Cancel
					}
				}
				if j.Status == "DONE" {
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Href:    "/read/" + j.ID,
					}) {
						Read
					}
				}
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Href:    "/documents/" + j.ID + "/edit",
				}) {
					Edit
				}
				if j.Status == "FAILED" {
					<form class="retry-form" method="POST" action={ templ.SafeURL("/documents/" + j.ID + "/retry") }>
						@button.Button(button.Props{
							Attributes: map[string]any{"data-retry-job": j.ID, "data-job-name": j.Filename},
							Variant:    button.VariantGhost,
							Size:       button.SizeSm,
							Type:       button.TypeSubmit,
						}) {
							Retry
						}
					</form>
				}
				if j.Status == "DONE" || j.Status == "FAILED" {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Attributes: map[string]any{"data-delete-job": j.ID, "data-job-name": j.Filename},
						Size:       button.SizeSm,
						Class:      "text-destructive hover:text-destructive",
						Type:       button.TypeButton,
					}) {
						Delete
					}
				}
			</div>
		}
	}
}

templ jobBadge(status string) {
	switch status {
		case "PENDING":
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				Pending
			}
		case "PROCESSING":
			@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
				Processing
			}
		case "FAILED":
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
				Failed
			}
		default:
	}
}

templ DocumentList(jobs []domain.Job) {
	if len(jobs) > 0 {
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
			for _, j := range jobs {
				@jobCard(j)
			}
		</div>
	}
}

templ Documents(jobs []domain.Job, watchJobIDs []string, errMsg string) {
	@Layout("Documents", NoAction(), NoAction(), NoAction(), "") {
		@ErrorBanner(errMsg)
		<div class="flex flex-col gap-8">
			<div class="flex flex-col gap-4">
				<!-- Title row with toggle -->
				@collapsible.Collapsible(collapsible.Props{ID: "add-document"}) {
					<div class="flex items-center justify-between">
						<h1 class="text-2xl font-semibold" style="font-family:'Lora',Georgia,serif;">Documents</h1>
						@collapsible.Trigger() {
							@button.Button(button.Props{
								Variant: button.VariantOutline,
								Size:    button.SizeSm,
							}) {
								<span class="flex items-center gap-1.5">
									@icon.Plus(icon.Props{Class: "w-3.5 h-3.5"})
									Add document
								</span>
							}
						}
					</div>
					<!-- Full-width collapsible form -->
					@collapsible.Content() {
						<div class="mt-4">
							@card.Card() {
								@card.Content() {
									<!-- Drop zone (upload) -->
									<form id="upload-form" method="POST" action="/documents" enctype="multipart/form-data">
										<input
											id="file-input"
											type="file"
											name="document"
											accept=".pdf,.epub"
											required
											class="sr-only"
										/>
										<div
											id="drop-zone"
											role="button"
											tabindex="0"
											aria-label="Drop a document here or click to browse"
											class="relative flex flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-border px-6 py-8 text-center transition-all duration-200 cursor-pointer hover:border-foreground/40 hover:bg-accent/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
										>
											<span class="text-muted-foreground/60 mb-1 pointer-events-none">
												@icon.FileUp(icon.Props{Class: "w-8 h-8"})
											</span>
											<p id="drop-label" class="text-sm font-medium text-foreground pointer-events-none" style="font-family:'DM Sans',sans-serif;">Drop a PDF here</p>
											<p class="text-xs text-muted-foreground pointer-events-none">or click to browse</p>
										</div>
										<div id="upload-actions" class="hidden mt-3 flex items-center justify-between gap-3 px-1">
											<span id="selected-filename" class="text-sm text-muted-foreground truncate flex-1"></span>
											@button.Button(button.Props{
												ID:   "upload-btn",
												Type: button.TypeSubmit,
												Size: button.SizeSm,
											}) {
												Upload
											}
										</div>
									</form>
									<noscript>
										<p class="mt-2 text-xs text-muted-foreground">JavaScript is disabled — use the file input above directly.</p>
									</noscript>
									<!-- Divider -->
									<div class="relative my-5">
										<div class="absolute inset-0 flex items-center"><span class="w-full border-t border-border"></span></div>
										<div class="relative flex justify-center"><span class="bg-card px-3 text-xs text-muted-foreground" style="font-family:'DM Sans',sans-serif;">or import from URL</span></div>
									</div>
									<!-- URL import -->
									<form method="POST" action="/documents/import" class="flex items-center gap-3">
										<input
											type="url"
											name="url"
											placeholder="https://example.com/paper.pdf"
											required
											class="flex-1 rounded-md border border-input bg-transparent px-3 py-1.5 text-sm shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
										/>
										@button.Button(button.Props{
											ID:   "import-btn",
											Type: button.TypeSubmit,
											Size: button.SizeSm,
										}) {
											Import
										}
									</form>
								}
							}
						</div>
					}
				}
			</div>
			@DocumentList(jobs)
		</div>
		if len(watchJobIDs) > 0 {
			<div id="watch-config" data-job-ids={ strings.Join(watchJobIDs, ",") } style="display:none"></div>
		}
		<script type="module" src="/static/js/documents.js"></script>
	}
}
