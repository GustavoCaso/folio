package templates

import "strings"
import "github.com/GustavoCaso/folio/ui/internal/db"

templ DocumentList(jobs []db.Job) {
	if len(jobs) > 0 {
		<ul>
			for _, j := range jobs {
				<li id={ "job-" + j.ID }>
					<strong class="filename">{ j.Filename }</strong>
					<span class={ "status status-" + string(j.Status) }>{ string(j.Status) }</span>
					<span class="detail">
						if j.Status == "FAILED" {
							{ j.Error } — <form class="retry-form" method="POST" action={ templ.SafeURL("/documents/" + j.ID + "/retry") } style="display:inline"><button type="submit">Retry</button></form>
						}
					</span>
					<span class="read-link">
						if j.Status == "DONE" {
							— <a href={ templ.SafeURL("/read/" + j.ID) }>Read</a>
						}
					</span>
					<span class="delete-action">
						if j.Status == "DONE" || j.Status == "FAILED" {
							<form class="delete-form" method="POST" action={ templ.SafeURL("/documents/" + j.ID + "/delete") }
								data-filename={ j.Filename }>
								<button type="submit">Delete</button>
							</form>
						}
					</span>
				</li>
			}
		</ul>
	}
}

templ Documents(jobs []db.Job, watchJobIDs []string, errMsg string) {
	@Layout("Documents") {
		@ErrorBanner(errMsg)
		<h1>Documents</h1>
		<form method="POST" action="/documents" enctype="multipart/form-data">
			<input type="file" name="document" accept=".pdf" required/>
			<button type="submit" id="upload-btn">Upload</button>
		</form>
    <noscript>
      <p>JavaScript is disabled, so live parser availability checks are unavailable. You can still submit an upload; if the parser is unavailable, the server will report the error.</p>
		</noscript>

		@DocumentList(jobs)

		if len(watchJobIDs) > 0 {
			<div id="watch-config" data-job-ids={ strings.Join(watchJobIDs, ",") } style="display:none"></div>
		}
		<script type="module" src="/static/documents.js"></script>
	}
}
