package templates

import (
	"unicode/utf8"

	"github.com/GustavoCaso/folio/ui/internal/db"
)

// BackendInitError is a view-model for a backend that failed to initialise at startup.
type BackendInitError struct {
	BackendName string
	Err         string
}

func truncate(s string, n int) string {
	if utf8.RuneCountInString(s) <= n {
		return s
	}
	runes := []rune(s)
	return string(runes[:n]) + "…"
}

templ exportStatusBadge(status string) {
	switch status {
		case "exported":
			<span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-green-100 text-green-800 border-green-200">Exported</span>
		case "failed":
			<span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-red-100 text-red-800 border-red-200">Failed</span>
		default:
			<span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-secondary text-secondary-foreground">{ status }</span>
	}
}

templ Exports(records []db.ExportRecord, initErrs []BackendInitError) {
	@Layout("Exports") {
		<div class="flex flex-col gap-6">
			<h1 class="text-2xl font-semibold">Export History</h1>
			for _, e := range initErrs {
				<div class="rounded-md border border-destructive bg-destructive/10 px-4 py-3 text-sm text-destructive" role="alert">
					<span class="font-semibold capitalize">{ e.BackendName }</span> backend failed to initialise: { e.Err }
				</div>
			}
			if len(records) == 0 {
				<p class="text-sm text-muted-foreground">No exports yet. Configure a backend via environment variables to start exporting highlights.</p>
			} else {
				<div class="overflow-x-auto rounded-lg border border-border">
					<table class="w-full text-sm">
						<thead class="bg-muted/50">
							<tr>
								<th class="px-4 py-3 text-left font-medium text-muted-foreground">Highlight</th>
								<th class="px-4 py-3 text-left font-medium text-muted-foreground">Document</th>
								<th class="px-4 py-3 text-left font-medium text-muted-foreground">Backend</th>
								<th class="px-4 py-3 text-left font-medium text-muted-foreground">Status</th>
								<th class="px-4 py-3 text-left font-medium text-muted-foreground">Exported At</th>
								<th class="px-4 py-3 text-left font-medium text-muted-foreground">Error</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, rec := range records {
								<tr class="hover:bg-muted/30 transition-colors">
									<td class="px-4 py-3 max-w-xs">
										<p class="text-foreground line-clamp-2 font-medium">{ truncate(rec.HighlightText, 80) }</p>
									</td>
									<td class="px-4 py-3 text-muted-foreground max-w-xs truncate">{ rec.JobFilename }</td>
									<td class="px-4 py-3">
										<span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-secondary text-secondary-foreground capitalize">{ rec.BackendName }</span>
									</td>
									<td class="px-4 py-3">
										@exportStatusBadge(rec.Status)
									</td>
									<td class="px-4 py-3 text-muted-foreground whitespace-nowrap">{ rec.ExportedAt.Format("2006-01-02 15:04") }</td>
									<td class="px-4 py-3 text-destructive text-xs max-w-xs truncate">{ rec.Error }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
