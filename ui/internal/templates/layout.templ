package templates

import "github.com/templui/templui/components/badge"
import "github.com/templui/templui/components/collapsible"
import "github.com/templui/templui/components/sheet"
import "github.com/templui/templui/components/toast"
import "github.com/templui/templui/components/icon"

templ NoAction() {
}

templ Layout(title string, headerActions templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Folio</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/tailwind/output.css"/>
			<link rel="stylesheet" href="/static/css/reader.css"/>
			@collapsible.Script()
			@sheet.Script()
			@toast.Script()
		</head>
		<body class="min-h-screen bg-background text-foreground">
			<header id="site-header" class="sticky top-0 z-40 border-b border-transparent bg-background/80 backdrop-blur-md transition-[border-color,box-shadow] duration-200">
				<div class="mx-auto max-w-4xl flex items-center justify-between px-4 py-3">
					<div class="flex items-center gap-6">
						<a href="/" class="group flex items-center gap-2 font-semibold tracking-tight text-foreground hover:opacity-70 transition-opacity" style="font-family:'DM Sans',sans-serif; letter-spacing:-0.02em;">
							@icon.BookOpen(icon.Props{Class: "h-4 w-4 -translate-y-px text-primary"})
							Folio
						</a>
						<a href="/exports" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Exports</a>
					</div>
					<div class="flex items-center gap-3">
						<div id="header-actions" class="flex items-center gap-2">
							@headerActions
						</div>
						<div id="parser-status-badge">
							@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
								Parser checking…
							}
						</div>
					</div>
				</div>
			</header>
			<main class="mx-auto max-w-4xl px-4 py-8">
				{ children... }
			</main>
			<script>
				(function() {
					var container = document.getElementById('parser-status-badge');

					function setBadge(s) {
						var variantClass = {
							healthy:   'bg-green-100 text-green-800 border-green-200',
							unhealthy: 'bg-red-100 text-red-800 border-red-200',
							checking:  'bg-secondary text-secondary-foreground',
						}[s] || 'bg-secondary text-secondary-foreground';

						var label = {
							healthy:   'Parser ready',
							unhealthy: 'Parser unavailable',
							checking:  'Parser checking…',
						}[s] || 'Parser checking…';

						container.innerHTML = '<span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold ' + variantClass + '">' + label + '</span>';
						
						var uploadBtn = document.getElementById('upload-btn');
						var retryBtns = document.querySelectorAll('[data-retry-job]');
						if (uploadBtn) { uploadBtn.disabled = (s !== 'healthy'); }
						retryBtns.forEach(function(retryBtn) {
							retryBtn.disabled = (s !== 'healthy');
						});
					}

					function poll() {
						fetch('/health/parser')
							.then(function(r) { return r.json(); })
							.then(function(d) { setBadge(d.status === 'healthy' ? 'healthy' : 'unhealthy'); })
							.catch(function()  { setBadge('unhealthy'); });
					}

					poll();
					setInterval(poll, 10000);
					
					var header = document.getElementById('site-header');
					if (!header) return;
					function onScroll() {
						var scrolled = window.scrollY > 8;
						header.classList.toggle('border-border', scrolled);
						header.classList.toggle('shadow-sm', scrolled);
						header.classList.toggle('border-transparent', !scrolled);
					}
					window.addEventListener('scroll', onScroll, { passive: true });
					onScroll();
					
				})();
			</script>
		</body>
	</html>
}

templ ErrorBanner(msg string) {
	if msg != "" {
		<div class="rounded-md border border-destructive bg-destructive/10 px-4 py-3 text-sm text-destructive mb-4" role="alert">{ msg }</div>
	}
}

templ ErrorPage(msg string) {
	@Layout("Error", NoAction()) {
		@ErrorBanner(msg)
	}
}
