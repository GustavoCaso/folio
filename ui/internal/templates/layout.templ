package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } — Folio</title>
		<style>
			body { font-family: sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
			nav a { margin-right: 1rem; }
			.status { font-size: 0.8em; color: #666; }
			.status-PENDING    { color: #999; }
			.status-PROCESSING { color: #0066cc; }
			.status-DONE       { color: #006600; }
			.status-FAILED     { color: #cc0000; }
			mark.highlight     { background: #ffe066; cursor: pointer; border-radius: 2px; }
			mark.highlight img { outline: 3px solid #ffeb3b; outline-offset: 2px; background: transparent; }
			.error-banner      { background: #fff0f0; border: 1px solid #cc0000; color: #cc0000; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1rem; }
			.parser-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; vertical-align:middle; }
			.parser-dot.healthy   { background:#006600; }
			.parser-dot.unhealthy { background:#cc0000; }
			.parser-dot.checking  { background:#999; }
			#parser-status-text   { font-size:0.8em; color:#666; }
		</style>
	</head>
	<body>
		<nav><a href="/">Documents</a>
		<span id="parser-status" class="parser-dot checking"></span><span id="parser-status-text">Parser checking…</span>
		</nav>
    <br>
		{ children... }
		<script>
		(function() {
			var dot  = document.getElementById('parser-status');
			var text = document.getElementById('parser-status-text');

			function setStatus(s) {
				dot.className = 'parser-dot ' + s;
				if (s === 'healthy')   { text.textContent = 'Parser ready'; }
				if (s === 'unhealthy') { text.textContent = 'Parser unavailable'; }
				if (s === 'checking')  { text.textContent = 'Parser checking…'; }

				var btn = document.getElementById('upload-btn');
				if (btn) { btn.disabled = (s !== 'healthy'); }
			}

			function poll() {
				fetch('/health/parser')
					.then(function(r) { return r.json(); })
					.then(function(d) { setStatus(d.status === 'healthy' ? 'healthy' : 'unhealthy'); })
					.catch(function()  { setStatus('unhealthy'); });
			}

			poll();
			setInterval(poll, 10000);
		})();
		</script>
	</body>
	</html>
}

templ ErrorBanner(msg string) {
	if msg != "" {
		<div class="error-banner" role="alert">{ msg }</div>
	}
}

templ ErrorPage(msg string) {
	@Layout("Error") {
		@ErrorBanner(msg)
	}
}
