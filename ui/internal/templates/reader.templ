package templates

import (
	"github.com/GustavoCaso/folio/ui/internal/db"
)

templ Reader(job db.Job, renderedHTML string, highlights []db.Highlight) {
	@Layout(job.Filename) {
		<div id="reader" data-job-id={ job.ID }>
			@templ.Raw(renderedHTML)
		</div>

		<div id="highlight-panel" style="display:none; position:fixed; bottom:1rem; right:1rem; background:#fff; border:1px solid #ccc; padding:1rem; border-radius:4px;">
			<input id="hl-tag" type="text" placeholder="Tag (optional)"/>
			<textarea id="hl-note" placeholder="Note (optional)" rows="3"></textarea>
			<button id="hl-save">Save highlight</button>
			<button id="hl-cancel">Cancel</button>
		</div>

		@templ.JSONScript("highlights-data", highlights)
		<script type="module" src="/static/highlight.js"></script>
		<script>
			window.__highlights = JSON.parse(document.getElementById("highlights-data").textContent);
		</script>
	}
}

