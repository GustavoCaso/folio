package templates

import (

	"github.com/GustavoCaso/folio/ui/internal/domain"
	"github.com/GustavoCaso/folio/ui/internal/views"
	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/table"
)

templ exportStatusBadge(status string) {
	switch status {
		case "EXPORTED":
			@badge.Badge(badge.Props{
				Class:   "bg-green-100 text-green-800 border-green-200",
				Variant: badge.VariantDefault}) {
				Exported
			}
		case "FAILED":
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
				Failed
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ status }
			}
	}
}

templ Exports(records []domain.ExportRecord) {
	@Layout("Exports", NoAction(), NoAction(), NoAction(), "", false) {
		<div class="flex flex-col gap-6">
			<h1 class="text-2xl font-semibold">Export History</h1>
			if len(records) == 0 {
				<p class="text-sm text-muted-foreground">No exports yet. Configure a backend via environment variables to start exporting highlights.</p>
			} else {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								Highlight
							}
							@table.Head() {
								Note
							}
							@table.Head() {
								Tags
							}
							@table.Head() {
								Document
							}
							@table.Head() {
								Backend
							}
							@table.Head() {
								Status
							}
							@table.Head() {
								Exported At
							}
							@table.Head() {
								Error
							}
						}
					}
					@table.Body() {
						for _, rec := range records {
							@table.Row() {
								@table.Cell() {
									<p class="line-clamp-2 font-medium">{ views.Truncate(rec.HighlightText, 80) }</p>
								}
								@table.Cell() {
									if rec.HighlightNote != "" {
										<p class="text-xs text-muted-foreground line-clamp-2">{ rec.HighlightNote }</p>
									} else {
										<span class="text-muted-foreground">--</span>
									}
								}
								@table.Cell() {
									<div class="flex flex-wrap gap-1">
										if rec.HighlightTag != "" {
											@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-xs"}) {
												{ rec.HighlightTag }
											}
										}
										for _, tag := range rec.DocumentTags {
											@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-xs"}) {
												{ tag }
											}
										}
										if rec.HighlightTag == "" && len(rec.DocumentTags) == 0 {
											<span class="text-muted-foreground">--</span>
										}
									</div>
								}
								@table.Cell() {
									<span class="text-muted-foreground truncate max-w-xs block">{ rec.DocumentFilename }</span>
								}
								@table.Cell() {
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
										{ rec.BackendName }
									}
								}
								@table.Cell() {
									@exportStatusBadge(rec.Status)
								}
								@table.Cell() {
									if rec.ExportedAt.IsZero() {
										<span class="text-muted-foreground whitespace-nowrap">--</span>
									} else {
										<span class="text-muted-foreground whitespace-nowrap">{ rec.ExportedAt.Format("2006-01-02 15:04") }</span>
									}
								}
								@table.Cell() {
									<span class="text-destructive text-xs truncate max-w-xs block">{ rec.Error }</span>
								}
							}
						}
					}
				}
			}
		</div>
	}
}
