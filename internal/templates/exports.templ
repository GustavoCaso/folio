package templates

import (
	"github.com/GustavoCaso/folio/ui/internal/domain"
	"github.com/GustavoCaso/folio/ui/internal/views"
	"github.com/templui/templui/components/badge"
)

templ exportStatusBadge(status string) {
	switch status {
		case "EXPORTED":
			@badge.Badge(badge.Props{
				Class:   "bg-green-100 text-green-800 border-green-200",
				Variant: badge.VariantDefault}) {
				Exported
			}
		case "FAILED":
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
				Failed
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ status }
			}
	}
}

templ Exports(records []domain.ExportRecord) {
	@Layout("Exports", NoAction(), NoAction(), highlightsHead(), "", false) {
		<div class="ex-page">
			<h1 class="ex-page-title">Export History</h1>
			if len(records) == 0 {
				<p class="text-sm text-muted-foreground">No exports yet. Configure a backend via environment variables to start exporting highlights.</p>
			} else {
				for _, group := range views.GroupExportsByDocument(records) {
					@exportBook(group)
				}
			}
		</div>
	}
}

templ exportBook(group views.DocumentExports) {
	<section class="ex-book">
		<header class="ex-book-head">
			<h2 class="ex-book-title">
				<a href={ templ.SafeURL(views.HighlightsHref(group.DocumentID)) }>{ group.Title }</a>
			</h2>
			<span class="ex-book-count">{ views.HighlightCountLabel(len(group.Records)) }</span>
		</header>
		<ol>
			for _, rec := range group.Records {
				@exportRow(rec)
			}
		</ol>
	</section>
}

templ exportRow(rec domain.ExportRecord) {
	<li class="ex-row">
		<div>
			<a class="ex-quote" href={ templ.SafeURL(views.HighlightHref(rec.DocumentID, rec.Chapter, rec.HighlightID)) }>
				<span class="hl-wash">{ views.Truncate(rec.HighlightText, 200) }</span>
			</a>
			if rec.HighlightNote != "" {
				<p class="hl-note">{ rec.HighlightNote }</p>
			}
			if rec.HighlightTag != "" || len(rec.DocumentTags) > 0 {
				<div class="ex-tags">
					if rec.HighlightTag != "" {
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "text-xs"}) {
							{ rec.HighlightTag }
						}
					}
					for _, tag := range rec.DocumentTags {
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-xs"}) {
							{ tag }
						}
					}
				</div>
			}
		</div>
		<div class="ex-meta">
			@exportStatusBadge(rec.Status)
			<span>{ rec.BackendName }</span>
			if !rec.ExportedAt.IsZero() {
				<time datetime={ rec.ExportedAt.Format("2006-01-02T15:04:05Z07:00") }>{ rec.ExportedAt.Format("2006-01-02 15:04") }</time>
			}
			if rec.Error != "" {
				<span class="ex-error">{ rec.Error }</span>
			}
		</div>
	</li>
}
