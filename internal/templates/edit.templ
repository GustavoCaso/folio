package templates

import (
	"strings"

	"github.com/GustavoCaso/folio/ui/internal/domain"
	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/form"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/separator"
)

templ EditDocument(j domain.Job, errMsg string) {
	@Layout("Edit Document", NoAction(), NoAction(), NoAction(), "") {
		@ErrorBanner(errMsg)
		<div class="flex flex-col gap-6">
			<!-- Header -->
			<div class="flex items-center gap-3">
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Href:    "/",
				}) {
					← Back
				}
				@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "h-5"})
				<h1 class="text-xl font-semibold" style="font-family:'Lora',Georgia,serif;">
					Edit { j.Title }
				</h1>
			</div>
			<!-- Two-column layout -->
			<div class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-8 items-start">
				<!-- Left: live preview -->
				<div class="flex flex-col gap-3">
					<p class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Preview</p>
					@card.Card(card.Props{Class: "overflow-hidden"}) {
						@card.Content(card.ContentProps{Class: "flex flex-col gap-3 p-4"}) {
							<!-- Cover -->
							<div id="preview-cover-wrap" class="w-full rounded overflow-hidden bg-muted aspect-[3/4] flex items-center justify-center">
								if len(j.Cover) > 0 {
									<img
										id="preview-cover-img"
										src={ "data:image/png;base64," + coverBase64(j) }
										alt="cover"
										class="w-full h-full object-cover"
									/>
								} else {
									<img
										id="preview-cover-img"
										src=""
										alt="cover"
										class="w-full h-full object-cover hidden"
									/>
									<span id="preview-cover-placeholder" class="text-xs text-muted-foreground text-center px-4 break-all">{ j.Filename }</span>
								}
							</div>
							<!-- Title -->
							<p
								id="preview-title"
								class="text-sm font-medium leading-snug truncate"
							>
								if j.Title != "" {
									{ j.Title }
								} else {
									{ j.Filename }
								}
							</p>
							<!-- Author -->
							<p
								id="preview-author"
								class={ "text-xs text-muted-foreground truncate" + func() string {
									if j.Author == "" {
										return " hidden"
									}
									return ""
								}() }
							>
								{ j.Author }
							</p>
							<!-- Tags -->
							<div
								id="preview-tags"
								class={ "flex flex-wrap gap-1" + func() string {
								if len(j.Tags) == 0 {
									return " hidden"
								}
								return ""
							}() }
							>
								for _, tag := range j.Tags {
									@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-xs"}) {
										{ tag }
									}
								}
							</div>
						}
					}
				</div>
				<!-- Right: form -->
				<div class="flex flex-col gap-4">
					<p class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Metadata</p>
					@card.Card() {
						@card.Content(card.ContentProps{Class: "p-6"}) {
							<form
								id="edit-form"
								method="POST"
								action={ templ.SafeURL("/documents/" + j.ID + "/edit") }
								enctype="multipart/form-data"
								class="flex flex-col gap-5"
							>
								@form.Item() {
									@form.Label(form.LabelProps{For: "title"}) {
										Title
									}
									@input.Input(input.Props{
										ID:          "title",
										Name:        "title",
										Type:        input.TypeText,
										Value:       j.Title,
										Placeholder: j.Filename,
									})
								}
								@form.Item() {
									@form.Label(form.LabelProps{For: "author"}) {
										Author
									}
									@input.Input(input.Props{
										ID:          "author",
										Name:        "author",
										Type:        input.TypeText,
										Value:       j.Author,
										Placeholder: "e.g. Jane Smith",
									})
								}
								@form.Item() {
									@form.Label(form.LabelProps{For: "tags"}) {
										Tags
									}
									@input.Input(input.Props{
										ID:          "tags",
										Name:        "tags",
										Type:        input.TypeText,
										Value:       strings.Join(j.Tags, ", "),
										Placeholder: "fiction, sci-fi, …",
									})
									@form.Description() {
										Comma-separated.
									}
								}
								@form.Item() {
									@form.Label(form.LabelProps{For: "cover"}) {
										Cover image
									}
									@input.Input(input.Props{
										ID:         "cover",
										Name:       "cover",
										Type:       input.TypeFile,
										FileAccept: "image/*",
									})
									@form.Description() {
										Replaces the current cover. Leave blank to keep existing.
									}
								}
								@separator.Separator(separator.Props{})
								<div class="flex items-center gap-2">
									@button.Button(button.Props{
										Type: button.TypeSubmit,
									}) {
										Save changes
									}
									@button.Button(button.Props{
										Variant: button.VariantOutline,
										Href:    "/",
									}) {
										Cancel
									}
								</div>
							</form>
						}
					}
				</div>
			</div>
		</div>
		<script>
		document.addEventListener('DOMContentLoaded', function () {
			const titleInput  = document.getElementById('title');
			const authorInput = document.getElementById('author');
			const coverInput  = document.getElementById('cover');

			const previewTitle       = document.getElementById('preview-title');
			const previewAuthor      = document.getElementById('preview-author');
			const previewImg         = document.getElementById('preview-cover-img');
			const previewPlaceholder = document.getElementById('preview-cover-placeholder');
			const previewTags        = document.getElementById('preview-tags');

			const fallbackTitle = titleInput?.placeholder || '';

			function syncTitle() {
				if (!previewTitle) return;
				previewTitle.textContent = titleInput.value.trim() || fallbackTitle;
			}

			function syncAuthor() {
				if (!previewAuthor) return;
				const v = authorInput.value.trim();
				previewAuthor.textContent = v;
				previewAuthor.classList.toggle('hidden', !v);
			}

			function syncCover(file) {
				if (!previewImg || !file) return;
				const reader = new FileReader();
				reader.onload = e => {
					previewImg.src = e.target.result;
					previewImg.classList.remove('hidden');
					if (previewPlaceholder) previewPlaceholder.classList.add('hidden');
				};
				reader.readAsDataURL(file);
			}

			const tagsInput = document.getElementById('tags');

			function syncTags() {
				if (!previewTags) return;
				const vals = (tagsInput?.value || '').split(',').map(t => t.trim()).filter(Boolean);
				previewTags.innerHTML = '';
				previewTags.classList.toggle('hidden', vals.length === 0);
				vals.forEach(tag => {
					const span = document.createElement('span');
					span.className = 'inline-flex items-center rounded-full bg-secondary text-secondary-foreground px-2 py-0.5 text-xs font-medium';
					span.textContent = tag;
					previewTags.appendChild(span);
				});
			}

			titleInput?.addEventListener('input', syncTitle);
			authorInput?.addEventListener('input', syncAuthor);
			tagsInput?.addEventListener('input', syncTags);
			coverInput?.addEventListener('change', () => syncCover(coverInput.files?.[0]));
		});
		</script>
	}
}
